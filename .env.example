# Variables pour `docker compose up` (développement local uniquement).
# Copier vers `.env` (ignoré par git) et remplacer les valeurs.

POSTGRES_DB=product_manager
POSTGRES_USER=product_manager
POSTGRES_PASSWORD=change-me

# Compte Basic Auth de l'API
API_USER=admin
API_PASSWORD=change-me

# URL d'arc-publisher (optionnel)
# ARC_PUBLISHER_URL=http://arc-publisher:8081
